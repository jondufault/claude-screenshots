#!/usr/bin/env python3
"""Screenshot Clipboard Manager — capture, name, and save clipboard images."""

import tkinter as tk
from tkinter import ttk, messagebox
import subprocess
import json
import io
import os
import sys

try:
    from PIL import Image, ImageTk
except ImportError:
    print("Pillow is required: pip install Pillow")
    sys.exit(1)


def grab_clipboard_image():
    """Get an image from the system clipboard."""
    # Windows and macOS: Pillow's ImageGrab handles it natively
    if sys.platform in ("win32", "darwin"):
        try:
            from PIL import ImageGrab
            img = ImageGrab.grabclipboard()
            if isinstance(img, Image.Image):
                return img
        except Exception:
            pass
        return None

    # Linux: try command-line clipboard tools
    for cmd in [
        ["wl-paste", "--type", "image/png"],
        ["xclip", "-selection", "clipboard", "-t", "image/png", "-o"],
    ]:
        try:
            result = subprocess.run(cmd, capture_output=True, timeout=2)
            if result.returncode == 0 and result.stdout:
                return Image.open(io.BytesIO(result.stdout))
        except (FileNotFoundError, subprocess.TimeoutExpired):
            continue
    return None


class ScreenshotManager:
    # Color palette
    BG = "#1a1b2e"
    BG_PANEL = "#232436"
    BG_CARD = "#2a2b3d"
    BG_INPUT = "#1e1f32"
    FG = "#e0e0f0"
    FG_DIM = "#6a6b8a"
    ACCENT = "#7289da"
    ACCENT_HOVER = "#8299ea"
    BORDER = "#3a3b5a"
    RED = "#e06070"
    THUMB_SELECTED = "#7289da"
    THUMB_BORDER = "#3a3b5a"

    THUMB_SIZE = (120, 90)
    PREVIEW_MAX = (600, 450)

    @staticmethod
    def _pick_font():
        """Pick the best available sans-serif font for the platform."""
        if sys.platform == "darwin":
            return "Helvetica Neue"
        elif sys.platform == "win32":
            return "Segoe UI"
        else:
            # Linux — try common options
            import tkinter.font as tkfont
            families = set(tkfont.families())
            for name in ("Inter", "Ubuntu", "Cantarell",
                         "Noto Sans", "DejaVu Sans"):
                if name in families:
                    return name
            return "sans-serif"

    def __init__(self, save_dir):
        self.save_dir = save_dir
        self.images = []       # list of {image, name_var, thumb_photo}
        self.selected = -1
        self.counter = 0

        self.root = tk.Tk()
        self.root.title("Screenshot Manager")
        self.root.geometry("900x680")
        self.root.minsize(700, 500)
        self.root.configure(bg=self.BG)

        self._setup_theme()
        self._build_ui()
        self._bind_keys()
        self.root.protocol("WM_DELETE_WINDOW", self._on_close)

    def _setup_theme(self):
        style = ttk.Style()
        style.theme_use("clam")
        font = self._pick_font()

        style.configure(".", background=self.BG, foreground=self.FG,
                        borderwidth=0, focuscolor=self.ACCENT)

        style.configure("TFrame", background=self.BG)
        style.configure("Panel.TFrame", background=self.BG_PANEL)

        style.configure("TLabel", background=self.BG, foreground=self.FG,
                        font=(font, 13))
        style.configure("Header.TLabel", background=self.BG,
                        foreground=self.FG, font=(font, 18, "bold"))
        style.configure("Dim.TLabel", background=self.BG,
                        foreground=self.FG_DIM, font=(font, 11))
        style.configure("PanelDim.TLabel", background=self.BG_PANEL,
                        foreground=self.FG_DIM, font=(font, 11))
        style.configure("Panel.TLabel", background=self.BG_PANEL,
                        foreground=self.FG, font=(font, 13))
        style.configure("Preview.TLabel", background=self.BG_PANEL,
                        foreground=self.FG_DIM, font=(font, 12))
        style.configure("Name.TLabel", background=self.BG_PANEL,
                        foreground=self.FG, font=(font, 14))

        style.configure("Accent.TButton", background=self.ACCENT,
                        foreground="#ffffff", font=(font, 13, "bold"),
                        padding=(24, 14))
        style.map("Accent.TButton",
                  background=[("active", self.ACCENT_HOVER)])

        style.configure("TButton", background=self.BG_CARD,
                        foreground=self.FG, font=(font, 13),
                        padding=(20, 14))
        style.map("TButton",
                  background=[("active", self.BG_PANEL)])

        style.configure("Small.TButton", background=self.BG_CARD,
                        foreground=self.RED, font=(font, 11),
                        padding=(14, 8))
        style.map("Small.TButton",
                  background=[("active", self.BG_PANEL)])

        style.configure("TEntry", fieldbackground=self.BG_INPUT,
                        foreground=self.FG, insertcolor=self.FG,
                        font=(font, 14), padding=(12, 10))

        style.configure("TSeparator", background=self.BORDER)

        style.configure("Vertical.TScrollbar",
                        background=self.BG_CARD, troughcolor=self.BG_PANEL,
                        borderwidth=0, arrowsize=0)
        style.map("Vertical.TScrollbar",
                  background=[("active", self.BORDER)])

    def _on_close(self):
        print(json.dumps({"action": "closed", "directory": self.save_dir,
                          "files": []}))
        self.root.destroy()

    def _build_ui(self):
        # Header
        header = ttk.Frame(self.root, padding=(20, 16, 20, 10))
        header.pack(fill="x")
        ttk.Label(header, text="Screenshot Manager",
                  style="Header.TLabel").pack(side="left")
        ttk.Button(header, text="Capture (Ctrl+V)", style="Accent.TButton",
                   command=self.capture).pack(side="right")

        # Subtitle
        sub = ttk.Frame(self.root, padding=(20, 0, 20, 10))
        sub.pack(fill="x")
        ttk.Label(sub, text=f"Saving to: {self.save_dir}",
                  style="Dim.TLabel").pack(side="left")

        ttk.Separator(self.root).pack(fill="x")

        # Main content: thumbnail strip (left) + preview (right)
        self.content = ttk.Frame(self.root)
        self.content.pack(fill="both", expand=True)
        self.content.columnconfigure(1, weight=1)
        self.content.rowconfigure(0, weight=1)

        # --- Left: thumbnail strip ---
        left = ttk.Frame(self.content, style="Panel.TFrame")
        left.grid(row=0, column=0, sticky="nsew")

        thumb_container = ttk.Frame(left, style="Panel.TFrame")
        thumb_container.pack(fill="both", expand=True)

        self.thumb_canvas = tk.Canvas(thumb_container, width=150,
                                      highlightthickness=0,
                                      bg=self.BG_PANEL, bd=0)
        thumb_scroll = ttk.Scrollbar(thumb_container, orient="vertical",
                                     command=self.thumb_canvas.yview)
        self.thumb_frame = ttk.Frame(self.thumb_canvas, style="Panel.TFrame")

        self.thumb_frame.bind(
            "<Configure>",
            lambda e: self.thumb_canvas.configure(
                scrollregion=self.thumb_canvas.bbox("all")))
        self.thumb_canvas.create_window((0, 0), window=self.thumb_frame,
                                        anchor="nw", tags="tf")
        self.thumb_canvas.bind(
            "<Configure>",
            lambda e: self.thumb_canvas.itemconfig("tf", width=e.width))

        self.thumb_canvas.pack(side="left", fill="both", expand=True)
        thumb_scroll.pack(side="right", fill="y")
        self.thumb_canvas.configure(yscrollcommand=thumb_scroll.set)

        # Mousewheel on thumbnails
        self.thumb_canvas.bind("<Button-4>",
                               lambda e: self.thumb_canvas.yview_scroll(-1, "units"))
        self.thumb_canvas.bind("<Button-5>",
                               lambda e: self.thumb_canvas.yview_scroll(1, "units"))

        # --- Right: preview area ---
        self.right = ttk.Frame(self.content, style="Panel.TFrame",
                               padding=(20, 20))
        self.right.grid(row=0, column=1, sticky="nsew")
        self.right.columnconfigure(0, weight=1)
        self.right.rowconfigure(0, weight=1)

        # Empty state (shown in the right panel)
        self.empty_label = ttk.Label(
            self.right,
            text=("No screenshots yet.\n\n"
                  "Take a screenshot, then press\n"
                  "Ctrl+V or click Capture."),
            justify="center", style="PanelDim.TLabel")
        self.empty_label.grid(row=0, column=0, rowspan=4)

        # Preview image (hidden initially)
        self.preview_label = ttk.Label(self.right, style="Panel.TLabel")
        self.preview_photo = None

        # Info label under preview
        self.info_var = tk.StringVar()
        self.info_label = ttk.Label(self.right, textvariable=self.info_var,
                                    style="PanelDim.TLabel")

        # Name entry under preview
        self.name_frame = ttk.Frame(self.right, style="Panel.TFrame")
        self.name_frame.columnconfigure(1, weight=1)
        ttk.Label(self.name_frame, text="Name:",
                  style="Name.TLabel").grid(row=0, column=0, padx=(0, 10))
        self.name_entry = ttk.Entry(self.name_frame)
        self.name_entry.grid(row=0, column=1, sticky="ew")
        ttk.Label(self.name_frame, text=".png",
                  style="PanelDim.TLabel").grid(row=0, column=2, padx=(6, 0))

        # Discard single button
        self.discard_btn = ttk.Button(self.right, text="Remove this screenshot",
                                      style="Small.TButton",
                                      command=self._discard_selected)

        # Bottom bar
        ttk.Separator(self.root).pack(fill="x")
        bottom = ttk.Frame(self.root, padding=(20, 14, 20, 18))
        bottom.pack(fill="x")

        ttk.Button(bottom, text="Save All & Close", style="Accent.TButton",
                   command=self.save_all).pack(side="right", padx=(10, 0))
        ttk.Button(bottom, text="Discard All",
                   command=self.discard_all).pack(side="right")

        self.status_var = tk.StringVar(value="Ready — Ctrl+V to capture")
        ttk.Label(bottom, textvariable=self.status_var,
                  style="Dim.TLabel").pack(side="left")

    def _bind_keys(self):
        self.root.bind_all("<Control-v>", self._on_paste)
        self.root.bind("<Control-s>", lambda e: self.save_all())
        self.root.bind("<Escape>", lambda e: self._on_close())
        self.name_entry.bind("<Return>", lambda e: self._commit_name())

    def _on_paste(self, event):
        """Ctrl+V: if focus is on a text entry, let default paste through; otherwise capture."""
        if event.widget is self.name_entry:
            return  # let tkinter handle normal text paste
        self.capture()

    def _commit_name(self):
        """Save the current name entry back to the selected image's name_var."""
        if 0 <= self.selected < len(self.images):
            self.images[self.selected]["name_var"].set(
                self.name_entry.get().strip())

    def capture(self):
        image = grab_clipboard_image()
        if image is None:
            self.status_var.set("No image in clipboard")
            messagebox.showinfo(
                "No Image",
                "No image found in clipboard.\n\n"
                "Take a screenshot first (PrtSc, or your screenshot tool),\n"
                "then come back and press Ctrl+V.")
            return

        self.counter += 1
        default_name = f"screenshot-{self.counter}"

        # Make thumbnail
        thumb = image.copy()
        thumb.thumbnail(self.THUMB_SIZE, Image.LANCZOS)
        thumb_photo = ImageTk.PhotoImage(thumb)

        name_var = tk.StringVar(value=default_name)
        entry = {"image": image, "name_var": name_var,
                 "thumb_photo": thumb_photo, "index": self.counter}
        self.images.append(entry)

        # Add thumbnail to the strip
        idx = len(self.images) - 1
        self._add_thumb_widget(entry, idx)

        # Select the new one
        self._select(idx)

        w, h = image.size
        self.status_var.set(
            f"Captured #{self.counter} ({w}x{h}) — {len(self.images)} total")

    def _add_thumb_widget(self, entry, idx):
        """Create a clickable thumbnail in the left strip."""
        frame = tk.Frame(self.thumb_frame, bg=self.THUMB_BORDER,
                         padx=3, pady=3)
        frame.pack(padx=10, pady=(10, 0))

        lbl = tk.Label(frame, image=entry["thumb_photo"],
                       bg=self.BG_PANEL, cursor="hand2")
        lbl.pack()

        lbl.bind("<Button-1>", lambda e, i=idx: self._select(i))
        entry["thumb_frame"] = frame
        entry["thumb_label"] = lbl

    def _select(self, idx):
        """Select a thumbnail and show its preview."""
        # Save current name before switching
        self._commit_name()

        self.selected = idx
        entry = self.images[idx]

        # Highlight selected thumb
        for i, e in enumerate(self.images):
            border_color = self.THUMB_SELECTED if i == idx else self.THUMB_BORDER
            e["thumb_frame"].configure(bg=border_color)

        # Hide empty state, show preview widgets
        self.empty_label.grid_forget()

        # Generate preview
        preview = entry["image"].copy()
        preview.thumbnail(self.PREVIEW_MAX, Image.LANCZOS)
        self.preview_photo = ImageTk.PhotoImage(preview)
        self.preview_label.configure(image=self.preview_photo)
        self.preview_label.grid(row=0, column=0, sticky="nsew", pady=(0, 12))

        # Info
        w, h = entry["image"].size
        self.info_var.set(f"{w} x {h} px")
        self.info_label.grid(row=1, column=0, sticky="w", pady=(0, 8))

        # Name
        self.name_frame.grid(row=2, column=0, sticky="ew", pady=(0, 8))
        self.name_entry.delete(0, tk.END)
        self.name_entry.insert(0, entry["name_var"].get())
        self.name_entry.focus_set()
        self.name_entry.select_range(0, tk.END)

        # Discard button
        self.discard_btn.grid(row=3, column=0, sticky="w", pady=(4, 0))

    def _discard_selected(self):
        if self.selected < 0:
            return

        idx = self.selected
        entry = self.images.pop(idx)
        entry["thumb_frame"].destroy()

        if not self.images:
            self.selected = -1
            self.preview_label.grid_forget()
            self.info_label.grid_forget()
            self.name_frame.grid_forget()
            self.discard_btn.grid_forget()
            self.empty_label.grid(row=0, column=0, rowspan=4)
        else:
            new_idx = min(idx, len(self.images) - 1)
            # Rebind click indices
            for i, e in enumerate(self.images):
                e["thumb_label"].bind(
                    "<Button-1>", lambda ev, j=i: self._select(j))
            self._select(new_idx)

        self.status_var.set(f"Removed — {len(self.images)} remaining")

    def save_all(self):
        self._commit_name()

        if not self.images:
            print(json.dumps({"action": "saved", "directory": self.save_dir,
                              "files": []}))
            self.root.destroy()
            return

        saved = []
        for entry in self.images:
            name = entry["name_var"].get().strip() or f"screenshot-{entry['index']}"
            name = "".join(
                c for c in name if c.isalnum() or c in "-_. ").strip()
            name = name.lstrip(". ")
            if not name:
                name = f"screenshot-{entry['index']}"

            filepath = os.path.join(self.save_dir, f"{name}.png")

            if os.path.exists(filepath):
                base = name
                i = 1
                while os.path.exists(
                        os.path.join(self.save_dir, f"{base}-{i}.png")):
                    i += 1
                filepath = os.path.join(self.save_dir, f"{base}-{i}.png")

            try:
                w, h = entry["image"].size
                entry["image"].save(filepath, "PNG")
                saved.append({"file": os.path.basename(filepath),
                              "path": filepath, "width": w, "height": h})
            except Exception as e:
                messagebox.showerror("Save Error",
                                     f"Failed to save {name}: {e}")
                return

        print(json.dumps({"action": "saved", "directory": self.save_dir,
                          "files": saved}))
        self.root.destroy()

    def discard_all(self):
        if self.images and not messagebox.askyesno(
                "Discard All", "Discard all screenshots without saving?"):
            return
        print(json.dumps({"action": "discarded", "directory": self.save_dir,
                          "files": []}))
        self.root.destroy()

    def run(self):
        self.root.mainloop()


def main():
    save_dir = sys.argv[1] if len(sys.argv) > 1 else os.getcwd()

    if not os.path.isdir(save_dir):
        print(f"Error: {save_dir} is not a valid directory")
        sys.exit(1)

    app = ScreenshotManager(save_dir)
    app.run()


if __name__ == "__main__":
    main()
