def png_dimensions(data):
    """Read width and height from a PNG header without Pillow."""
    if data[:8] != b'\x89PNG\r\n\x1a\n':
        return None, None
    width, height = struct.unpack('>II', data[16:24])
    return width, height


class Handler(BaseHTTPRequestHandler):
    """HTTP request handler for the screenshot manager."""

    def log_message(self, format, *args):
        # Silence default request logging
        pass

    def do_GET(self):
        global last_ping
        if self.path == "/ping":
            last_ping = time.monotonic()
            self.send_response(200)
            self.send_header("Content-Type", "text/plain")
            self.end_headers()
            self.wfile.write(b"pong")
            return

        if self.path == "/":
            page = HTML_PAGE.replace("{{SAVE_DIR}}", html.escape(SAVE_DIR))
            page = page.replace("{{CSRF_TOKEN}}", CSRF_TOKEN)
            body = page.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return

        self.send_error(404)

    def do_POST(self):
        global last_ping

        content_length = int(self.headers.get("Content-Length", 0))
        body = self.rfile.read(content_length)

        # /close uses sendBeacon with URL-encoded form data
        if self.path == "/close":
            from urllib.parse import parse_qs
            params = parse_qs(body.decode())
            if params.get("csrf", [None])[0] != CSRF_TOKEN:
                self.send_error(403)
                return
            self.send_response(200)
            self.send_header("Content-Type", "text/plain")
            self.end_headers()
            self.wfile.write(b"ok")
            output_and_shutdown({"action": "closed", "directory": SAVE_DIR, "files": []})
            return

        # JSON endpoints
        try:
            data = json.loads(body)
        except (json.JSONDecodeError, UnicodeDecodeError):
            self.send_error(400)
            return

        if data.get("csrf") != CSRF_TOKEN:
            self.send_error(403)
            return

        if self.path == "/discard":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(b'{"ok":true}')
            output_and_shutdown({"action": "discarded", "directory": SAVE_DIR, "files": []})
            return

        if self.path == "/save":
            result = save_images(data.get("images", []))
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(b'{"ok":true}')
            output_and_shutdown(result)
            return

        self.send_error(404)


def sanitize_name(name, fallback_index):
    """Sanitize a screenshot name for use as a filename."""
    name = name.strip()
    if not name:
        name = f"screenshot-{fallback_index}"
    name = "".join(c for c in name if c.isalnum() or c in "-_. ").strip()
    name = name.lstrip(". ")
    if not name:
        name = f"screenshot-{fallback_index}"
    return name


def save_images(image_list):
    """Decode base64 images and save to disk. Returns JSON result dict."""
    saved = []
    for i, entry in enumerate(image_list, 1):
        name = sanitize_name(entry.get("name", ""), i)
        data_url = entry.get("dataUrl", "")

        # Strip data URL prefix
        if "," in data_url:
            b64 = data_url.split(",", 1)[1]
        else:
            b64 = data_url

        try:
            img_data = base64.b64decode(b64)
        except Exception:
            continue

        # Get dimensions from PNG header
        width, height = png_dimensions(img_data)
        if width is None:
            # Fallback to what the browser reported
            width = entry.get("width", 0)
            height = entry.get("height", 0)

        filepath = os.path.join(SAVE_DIR, f"{name}.png")

        # Handle name collisions
        if os.path.exists(filepath):
            base = name
            n = 1
            while os.path.exists(os.path.join(SAVE_DIR, f"{base}-{n}.png")):
                n += 1
            filepath = os.path.join(SAVE_DIR, f"{base}-{n}.png")

        try:
            with open(filepath, "wb") as f:
                f.write(img_data)
            saved.append({
                "file": os.path.basename(filepath),
                "path": filepath,
                "width": width,
                "height": height,
            })
        except OSError as e:
            print(f"Warning: failed to save {name}: {e}", file=sys.stderr)

    return {"action": "saved", "directory": SAVE_DIR, "files": saved}


def output_and_shutdown(result):
    """Print JSON to stdout and shut down the server from a background thread."""
    def _shutdown():
        time.sleep(0.5)  # Let browser receive response before shutdown
        print(json.dumps(result))
        sys.stdout.flush()
        server_instance.shutdown()
    threading.Thread(target=_shutdown, daemon=True).start()


def heartbeat_watchdog():
    """Detect browser tab closure via missing pings."""
    global last_ping
    while True:
        time.sleep(5)
        if last_ping > 0 and (time.monotonic() - last_ping) > 10:
            output_and_shutdown({"action": "closed", "directory": SAVE_DIR, "files": []})
            return


def main():
    global SAVE_DIR, CSRF_TOKEN, server_instance, last_ping

    SAVE_DIR = sys.argv[1] if len(sys.argv) > 1 else os.getcwd()

    if not os.path.isdir(SAVE_DIR):
        print(f"Error: {SAVE_DIR} is not a valid directory", file=sys.stderr)
        sys.exit(1)

    CSRF_TOKEN = secrets.token_urlsafe(32)

    # Find a free port
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    sock.bind(("127.0.0.1", 0))
    port = sock.getsockname()[1]
    sock.close()

    server_instance = HTTPServer(("127.0.0.1", port), Handler)
    last_ping = time.monotonic()

    url = f"http://127.0.0.1:{port}"
    print(f"Screenshot Manager running at {url}", file=sys.stderr)

    # Start heartbeat watchdog
    threading.Thread(target=heartbeat_watchdog, daemon=True).start()

    # Open browser
    try:
        webbrowser.open(url)
    except Exception:
        print(f"Could not open browser. Open this URL manually: {url}", file=sys.stderr)

    server_instance.serve_forever()


if __name__ == "__main__":
    main()
