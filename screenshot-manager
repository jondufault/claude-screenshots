<script>
const CSRF = "{{CSRF_TOKEN}}";
const images = [];   // {dataUrl, name, width, height}
let selected = -1;
let counter = 0;

// ── Heartbeat ──────────────────────────────────────────────────────────────
setInterval(() => {
  fetch("/ping", {method: "GET"}).catch(() => {});
}, 3000);

window.addEventListener("beforeunload", () => {
  navigator.sendBeacon("/close", new URLSearchParams({csrf: CSRF}));
});

// ── Paste handling ─────────────────────────────────────────────────────────
document.addEventListener("paste", e => {
  // If the name input is focused, only handle if there are image items
  if (document.activeElement === document.getElementById("nameInput")) {
    // Let normal text paste through if no images in clipboard
    if (!e.clipboardData || !e.clipboardData.items) return;
    let hasImage = false;
    for (const item of e.clipboardData.items) {
      if (item.type.startsWith("image/")) { hasImage = true; break; }
    }
    if (!hasImage) return;
  }
  if (!e.clipboardData || !e.clipboardData.items) return;
  for (const item of e.clipboardData.items) {
    if (item.type.startsWith("image/")) {
      e.preventDefault();
      const blob = item.getAsFile();
      if (blob) handleImageBlob(blob);
      return;
    }
  }
  setStatus("No image in clipboard");
});

function pasteImage() {
  // Trigger a clipboard read via the Clipboard API
  if (navigator.clipboard && navigator.clipboard.read) {
    navigator.clipboard.read().then(items => {
      for (const item of items) {
        for (const type of item.types) {
          if (type.startsWith("image/")) {
            item.getType(type).then(blob => handleImageBlob(blob));
            return;
          }
        }
      }
      setStatus("No image in clipboard");
    }).catch(() => {
      setStatus("Clipboard access denied — use Ctrl+V instead");
    });
  } else {
    setStatus("Use Ctrl+V to paste");
  }
}

function handleImageBlob(blob) {
  // Normalize to PNG via canvas
  const img = new Image();
  const url = URL.createObjectURL(blob);
  img.onload = () => {
    const canvas = document.createElement("canvas");
    canvas.width = img.naturalWidth;
    canvas.height = img.naturalHeight;
    canvas.getContext("2d").drawImage(img, 0, 0);
    const dataUrl = canvas.toDataURL("image/png");
    URL.revokeObjectURL(url);

    counter++;
    const entry = {
      dataUrl,
      name: "screenshot-" + counter,
      width: img.naturalWidth,
      height: img.naturalHeight
    };
    images.push(entry);
    addThumb(images.length - 1);
    selectImage(images.length - 1);
    setStatus("Captured #" + counter + " (" + entry.width + "\u00d7" + entry.height + ") \u2014 " + images.length + " total");
  };
  img.src = url;
}

// ── Thumbnail strip ────────────────────────────────────────────────────────
function addThumb(idx) {
  const div = document.createElement("div");
  div.className = "thumb";
  div.dataset.idx = idx;
  div.onclick = () => selectImage(idx);
  const img = document.createElement("img");
  img.src = images[idx].dataUrl;
  div.appendChild(img);
  document.getElementById("thumbs").appendChild(div);
}

function rebuildThumbs() {
  const container = document.getElementById("thumbs");
  container.innerHTML = "";
  images.forEach((_, i) => addThumb(i));
  // Re-highlight
  document.querySelectorAll(".thumb").forEach((el, i) => {
    el.classList.toggle("selected", i === selected);
  });
}

// ── Selection / Preview ────────────────────────────────────────────────────
function selectImage(idx) {
  // Save current name
  commitName();
  selected = idx;
  const entry = images[idx];

  // Highlight thumb
  document.querySelectorAll(".thumb").forEach((el, i) => {
    el.classList.toggle("selected", i === idx);
  });

  // Show preview
  document.getElementById("emptyState").style.display = "none";
  const prevImg = document.getElementById("previewImg");
  prevImg.src = entry.dataUrl;
  prevImg.style.display = "block";
  document.getElementById("previewInfo").textContent = entry.width + " \u00d7 " + entry.height + " px";
  document.getElementById("previewInfo").style.display = "block";
  document.getElementById("nameRow").style.display = "flex";
  document.getElementById("removeRow").style.display = "block";

  const nameInput = document.getElementById("nameInput");
  nameInput.value = entry.name;
  nameInput.focus();
  nameInput.select();
}

function commitName() {
  if (selected >= 0 && selected < images.length) {
    const val = document.getElementById("nameInput").value.trim();
    if (val) images[selected].name = val;
  }
}

function removeSelected() {
  if (selected < 0) return;
  images.splice(selected, 1);
  if (images.length === 0) {
    selected = -1;
    document.getElementById("previewImg").style.display = "none";
    document.getElementById("previewInfo").style.display = "none";
    document.getElementById("nameRow").style.display = "none";
    document.getElementById("removeRow").style.display = "none";
    document.getElementById("emptyState").style.display = "block";
  } else {
    selected = Math.min(selected, images.length - 1);
  }
  rebuildThumbs();
  if (selected >= 0) selectImage(selected);
  setStatus("Removed \u2014 " + images.length + " remaining");
}

// ── Actions ────────────────────────────────────────────────────────────────
function showDoneOverlay(msg) {
  const overlay = document.createElement("div");
  overlay.style.cssText = "position:fixed;top:0;left:0;right:0;bottom:0;width:100vw;height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:99999;background:#1a1b2e;color:#e0e0f0;";
  overlay.innerHTML = '<div style="font-size:72px;margin-bottom:24px;color:#7289da;">&#10004;</div>' +
    '<div style="font-size:28px;font-weight:700;margin-bottom:16px;color:#e0e0f0;">' + msg + '</div>' +
    '<div style="font-size:15px;color:#6a6b8a;">You can close this tab now.</div>';
  document.body.appendChild(overlay);
}

function saveAll() {
  commitName();
  const payload = images.map(e => ({
    name: e.name,
    dataUrl: e.dataUrl,
    width: e.width,
    height: e.height
  }));
  fetch("/save", {
    method: "POST",
    headers: {"Content-Type": "application/json"},
    body: JSON.stringify({csrf: CSRF, images: payload})
  }).then(() => {
    document.title = "Screenshot Manager (saved)";
    showDoneOverlay("Saved!");
  }).catch(() => {
    setStatus("Save failed \u2014 check the terminal for errors");
  });
}

function discardAll() {
  if (images.length > 0 && !confirm("Discard all screenshots without saving?")) return;
  document.title = "Screenshot Manager (discarded)";
  showDoneOverlay("Discarded.");
  fetch("/discard", {
    method: "POST",
    headers: {"Content-Type": "application/json"},
    body: JSON.stringify({csrf: CSRF})
  }).catch(() => {});
}

function setStatus(msg) {
  document.getElementById("status").textContent = msg;
}

// ── Keyboard shortcuts ─────────────────────────────────────────────────────
document.addEventListener("keydown", e => {
  if (e.ctrlKey && e.key === "s") {
    e.preventDefault();
    saveAll();
  } else if (e.key === "Escape") {
    e.preventDefault();
    discardAll();
  }
});
</script>
